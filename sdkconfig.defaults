# Based on Waveshare ESP32-S3-Touch-LCD-4 LVGL v9 example configuration.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_SPEED_80M=y
# Keep only very small allocations preferentially internal; larger general allocations may use PSRAM.
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=128
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# PSRAM-first Wi-Fi requires static TX in ESP-IDF 5.5.3. Bound its DMA
# buffers explicitly rather than accepting the larger PSRAM-enabled defaults.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=4
# Four HTTP sessions + three HTTP infrastructure sockets + W2K/HTTPS/headroom.
CONFIG_LWIP_MAX_SOCKETS=10
# Local AP/OTA and W2K are IPv4-only; disabling IPv6 avoids unused lwIP state.
CONFIG_LWIP_IPV6=n
# Two MSS per direction: lower peak socket memory, lower bulk-upload throughput.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880
# Keep PSRAM-enabled defaults from making out-of-order queues unbounded.
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=2
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_HZ=1000
# Startup loads/migrates NVS and initializes display, radio and OTA services.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# BLE-only use through the ESP-IDF Bluedroid GAP scanner.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
# SmartShunt uses the legacy esp_ble_gap_set_scan_params/start_scanning API.
# On ESP32-S3 that implementation is compiled only with Bluedroid BLE 4.2
# scanning support; BLE 5 extended scanning is a different API.
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_42_SCAN_EN=y
# Scan-only SmartShunt reader: no GATT client/server and no BLE pairing/security.
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_BLE_SMP_ENABLE=n
CONFIG_BT_SMP_ENABLE=n
# One scan plus controller housekeeping; no BLE connections are created.
CONFIG_BT_CTRL_BLE_MAX_ACT=2
# CONFIG_BT_BLE_50_FEATURES_SUPPORTED is not set
# Pin Bluedroid to core 0; BLE is enabled above and Classic Bluetooth is disabled below.
CONFIG_BT_BLUEDROID_PINNED_TO_CORE_0=y
CONFIG_BT_CLASSIC_ENABLED=n

CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
# One software draw unit avoids a second 8 KB internal render-task stack.
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
# Two 10-row RGB DMA bounce buffers use ~19.2 KB total instead of ~38.4 KB.
CONFIG_BSP_LCD_RGB_BOUNCE_BUFFER_HEIGHT=10
# CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM is not set
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_TXT_BREAK_CHARS=" ,.;:-_"

# Safe dual-slot OTA rollback.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
